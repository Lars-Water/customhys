{
    "logger_lvl": "INFO",
    "parameter_tuning": {
        "parameter_names": [
            "LargeNet.**.cli.sendInterval"
        ],
        "parameter_ranges": [
            ["exponential(0.5s)", "0.1s", "0.5s", "1s", "exponential(0.1s)", "exponential(1s)"]
        ]
    },
    "coordinator_functionalities": {
