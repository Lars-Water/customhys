                "values": [
                    "10Mbps",
                    "100Mbps",
                    "1Gbps",
                    "10Gbps"
                ]
            },
            {
                "param_name": "cost",
                "ignore_normalization": false,
                "configuration_pattern": "**.switchBB[__switch_index].ethg$o[__gate_index].channel.cost",
                "values": [
                    1,
                    2,
                    5,
                    10
                ]
            },
            {
                "param_name": "cable_colour",
                "ignore_normalization": true,
                "configuration_pattern": "**.switchBB[__switch_index].ethg$o[__gate_index].channel.display-string",
                "values": [
                    "ls=red,3,s;",
                    "ls=blue,3,s;",
                    "ls=green,3,s;",
                    "ls=yellow,3,s;"
                ]
            }
        ]
