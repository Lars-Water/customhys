            "largeNet.ini"
        ]
    },
    "results_path": "/var/scratch/mherget/hh_exp1/data/raw",
    "output_paths": {
        "agents_fitness_values_path": "/var/scratch/mherget/hh_exp1/design_points/agents_fitness",
