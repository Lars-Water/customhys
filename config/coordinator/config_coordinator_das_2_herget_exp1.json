            "experiments_path": "/var/scratch/mherget/hh_exp1/experiments_inet",
            "generated_path": "/var/scratch/mherget/hh_exp1/generated",
            "simulation_model_template_path": "/var/scratch/mherget/hyper-heuristic-dse-2.0/src_main/external/simulation_model/sims/dummy_sim_lans",
            "simulation_model_generated_path": "/var/scratch/mherget/hh_exp1/generated/custom_dummy"
        },
        "simulation_model_configuration": {
            "sim_model": "custom",
            "platform": "DAS",
            "jobs": 3,
            "job_cores": 64,
            "job_processes": 1,
            "job_memory": "120GB",
            "num_nodes": 1,
            "num_workers": 1,
            "threads_per_worker": 8,
            "walltime": "200:0:0",
            "oversubscribe": true
        },
        "simulation_model_params": [
            {
